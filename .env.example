# Copie este arquivo para .env.local e ajuste os valores.
# .env.local nunca deve ser commitado (já está no .gitignore).
#
# ATENÇÃO AO DEPLOY: as variáveis NEXT_PUBLIC_* são CONGELADAS no momento do
# `next build` — elas são substituídas por texto fixo dentro do pacote que vai
# ao navegador, e trocá-las na hora de subir o servidor não muda nada. Ou seja:
# um build feito nesta máquina, com os valores de desenvolvimento abaixo, leva
# "ws://localhost:8080" embutido para produção. Construa com as variáveis de
# produção definidas.
#
# O painel confere isso na subida (ver security/ambiente.ts) e, em produção,
# se RECUSA a atender se encontrar configuração de desenvolvimento — do mesmo
# jeito que o backend Go se recusa a subir (ver lib/security/ambiente).

# URL do backend, usada apenas pelas rotas internas do Next (app/api/*).
# Nunca exposta ao navegador — todas as chamadas do client passam por
# app/api/*, que encaminham para cá no servidor.
API_URL=http://localhost:8080

# Endereço público da vitrine (o outro front, em vendas/frontp). O painel usa
# só para montar e exibir o link da loja do lojista — por isso é NEXT_PUBLIC,
# ela aparece no navegador. Sem barra no final.
NEXT_PUBLIC_VITRINE_URL=http://localhost:3001

# Endereço do WebSocket que traz as conversas ao vivo. É o mesmo servidor de
# API_URL, só que como ws:// (ou wss:// atrás de HTTPS) e visto pelo
# NAVEGADOR — daí ser NEXT_PUBLIC: quem abre a conexão é a aba do lojista, e
# não o servidor do Next.
#
# A origem do painel precisa estar em CORS_ALLOWED_ORIGINS no backend: o
# socket confere a origem pela mesma lista do CORS.
#
# Em produção use wss://. O bilhete de acesso viaja na URL do socket (o
# navegador não deixa mandar cabeçalho ao abrir a conexão) e as conversas dos
# clientes voltam por ele — em ws:// tudo isso trafega em texto puro. O front
# sobe para wss:// sozinho quando o painel é servido por HTTPS, mas deixe a
# variável certa mesmo assim: é ela que o proxy declara no connect-src da CSP.
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# Quantos proxies confiáveis (Nginx, Caddy, load balancer) existem na frente
# do Next. É o que diz qual entrada de X-Forwarded-For o rate limit deve ler:
# lê-se de trás para frente, porque as primeiras posições são escritas por
# quem chama e serviriam para trocar de IP a cada tentativa de login.
#
# O padrão é 0: sem declaração, o cabeçalho é ignorado e vale o IP da conexão.
# Supor um proxy que não existe faria o limite ler um cabeçalho que qualquer
# um escreve. Use 1 atrás de um Nginx/Caddy, e o número de saltos se houver
# mais de um. É o mesmo padrão do backend Go (TRUSTED_PROXIES).
TRUSTED_PROXY_COUNT=0
